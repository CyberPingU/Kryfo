+        _Card(
+          icon: Icons.lock_clock_outlined,
+          title: l10n.onboardingProtectionOneTimeTitle,
+          desc: l10n.onboardingProtectionOneTimeLine,
+        ),
+      ],
+    );
+  }
+}
